# Local development configuration. Do NOT put real secrets in this file.
# Run ./scripts/gen-dev-env.sh to create .env with a generated database password.
# .env is git-ignored. In production, inject configuration from the environment or
# mounted secret files (DISTRIBUTED_STORAGE_<NAME>_FILE), never from a committed file.

DISTRIBUTED_STORAGE_ENV=dev
DISTRIBUTED_STORAGE_SERVICE_NAME=distributed-storage-api
DISTRIBUTED_STORAGE_LOG_LEVEL=INFO

DISTRIBUTED_STORAGE_DB_HOST=localhost
DISTRIBUTED_STORAGE_DB_PORT=5432
DISTRIBUTED_STORAGE_DB_NAME=distributed_storage
DISTRIBUTED_STORAGE_DB_USER=distributed_storage
# Required. Intentionally empty: the app and Docker Compose refuse to start without it.
DISTRIBUTED_STORAGE_DB_PASSWORD=
